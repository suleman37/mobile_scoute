MONGODB_URI=mongodb://127.0.0.1:27017/mobile_scoute
PORT=5000
# Protects POST /api/scrape/sync. Use a long random value in your real .env file.
SCRAPER_API_KEY=replace-with-a-long-random-secret
# Direct product pages may be passed here.
SCRAPER_SOURCE_URLS=https://approved-marketplace-product-url
# Public PriceOye category pages used to discover individual product URLs.
SCRAPER_DISCOVERY_URLS=https://priceoye.pk/mobiles/pricelist/best-5g-phones
SCRAPER_AUTO_SYNC=true
SCRAPER_REFRESH_MINUTES=15
# Optional: enables official, model-specific YouTube review lookups.
YOUTUBE_API_KEY=
